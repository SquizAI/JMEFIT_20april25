# JMEFIT Environment Variables
# Copy this file to .env and fill in your actual values

# ============================================================================
# SUPABASE CONFIGURATION
# ============================================================================
# These are safe to expose with VITE_ prefix (public read-only access)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Service key - SERVER-SIDE ONLY (no VITE_ prefix!)
SUPABASE_SERVICE_KEY=your_service_key_here

# ============================================================================
# STRIPE CONFIGURATION
# ============================================================================
# CRITICAL: Only the publishable key should have VITE_ prefix
# The secret key must NEVER have VITE_ prefix!

# Publishable key (SAFE to expose - client-side)
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_your_publishable_key_here

# Secret key (SECRET - server-side only, NO VITE_ PREFIX!)
STRIPE_SECRET_KEY=sk_live_your_secret_key_here

# Webhook signing secret (get from Stripe Dashboard > Developers > Webhooks)
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# ============================================================================
# EMAIL CONFIGURATION (SMTP)
# ============================================================================
# All email variables are server-side only (no VITE_ prefix)
SMTP_HOST=your_smtp_host
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@domain.com
SMTP_PASSWORD=your_smtp_password
DEFAULT_FROM_EMAIL=your_email@domain.com

# ============================================================================
# GOOGLE OAUTH CONFIGURATION
# ============================================================================
# Client ID is safe to expose (public)
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Client secret is private (but currently has VITE_ prefix - needs fixing)
VITE_GOOGLE_CLIENT_SECRET=your_google_client_secret

# ============================================================================
# AI API KEYS
# ============================================================================
# Gemini API key (Google AI)
VITE_GEMINI_API_KEY=your_gemini_api_key

# OpenAI API key (used in both client and server)
VITE_OPENAI_API_KEY=your_openai_api_key
OPENAI_API_KEY=your_openai_api_key

# ============================================================================
# VARIABLE NAMING RULES
# ============================================================================
#
# VITE_ prefix = EXPOSED TO CLIENT (visible in browser)
#   - Use ONLY for public/publishable keys
#   - Examples: Supabase anon key, Stripe publishable key
#
# NO VITE_ prefix = SERVER-SIDE ONLY (never exposed to client)
#   - Use for secret keys, passwords, API keys
#   - Examples: Stripe secret key, database passwords
#
# ============================================================================
# SECURITY CHECKLIST
# ============================================================================
#
# ✅ SAFE to use VITE_ prefix:
#   - VITE_SUPABASE_URL
#   - VITE_SUPABASE_ANON_KEY
#   - VITE_STRIPE_PUBLISHABLE_KEY
#   - VITE_GOOGLE_CLIENT_ID
#
# ❌ NEVER use VITE_ prefix for:
#   - STRIPE_SECRET_KEY (starts with sk_)
#   - SUPABASE_SERVICE_KEY (has admin access)
#   - SMTP_PASSWORD
#   - Any OAuth client secrets
#   - Webhook secrets
#
# ============================================================================
