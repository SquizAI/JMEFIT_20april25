# Admin paths - more permissive for admin functionality
/admin/*
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Methods: GET, POST, PUT, DELETE, OPTIONS
  Access-Control-Allow-Headers: Origin, X-Requested-With, Content-Type, Accept
  X-Frame-Options: DENY
  X-XSS-Protection: 1; mode=block
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: default-src *; script-src * 'unsafe-inline' 'unsafe-eval' blob:; style-src * 'unsafe-inline'; font-src * data:; img-src * data: blob:; connect-src *; worker-src * blob: data:;

# JavaScript files
/*.js
  Content-Type: application/javascript; charset=utf-8
  Cache-Control: public, max-age=31536000
  Access-Control-Allow-Origin: *

/assets/*.js
  Content-Type: application/javascript; charset=utf-8
  Cache-Control: public, max-age=31536000
  Access-Control-Allow-Origin: *

# CSS files
/*.css
  Content-Type: text/css; charset=utf-8
  Cache-Control: public, max-age=31536000
  Access-Control-Allow-Origin: *

/assets/*.css
  Content-Type: text/css; charset=utf-8
  Cache-Control: public, max-age=31536000
  Access-Control-Allow-Origin: *

# All paths
/*
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Methods: GET, POST, PUT, DELETE, OPTIONS
  Access-Control-Allow-Headers: Origin, X-Requested-With, Content-Type, Accept
  X-Frame-Options: DENY
  X-XSS-Protection: 1; mode=block
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: default-src 'self' https: http: data: blob: wss: ws:; connect-src 'self' https: http: data: blob: wss: ws: https://*.supabase.co wss://*.supabase.co https://api.openai.com; img-src 'self' https: http: data: blob:; script-src 'self' 'unsafe-inline' 'unsafe-eval' https: http: blob:; style-src 'self' 'unsafe-inline' https: http:; font-src 'self' https: http: data: blob: 'unsafe-inline'; frame-src 'self' https:; object-src 'none'; base-uri 'self'; form-action 'self' https://checkout.stripe.com; worker-src 'self' blob: data:;

# Image files
/*.png
  Cache-Control: public, max-age=31536000
  Access-Control-Allow-Origin: *

/*.jpg
  Cache-Control: public, max-age=31536000
  Access-Control-Allow-Origin: *

/*.jpeg
  Cache-Control: public, max-age=31536000
  Access-Control-Allow-Origin: *

/*.svg
  Cache-Control: public, max-age=31536000
  Access-Control-Allow-Origin: *

/*.gif
  Cache-Control: public, max-age=31536000
  Access-Control-Allow-Origin: *

/*.webp
  Cache-Control: public, max-age=31536000
  Access-Control-Allow-Origin: *

/*.PNG
  Cache-Control: public, max-age=31536000
  Access-Control-Allow-Origin: *
